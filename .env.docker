# irStudy Medical Education Platform - Docker Stack Environment
# Copy this file to .env and fill in actual values
# NEVER commit .env to Git (already in .gitignore)

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=irstudy_medical
POSTGRES_USER=postgres
# Note: Password loaded from Docker secret (/run/secrets/db_password)
DATABASE_URL=postgresql://postgres:__SECRET__@postgres:5432/irstudy_medical

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://:__SECRET__@redis:6379/0

# =============================================================================
# QDRANT VECTOR DATABASE
# =============================================================================
QDRANT_URL=http://qdrant:6333
QDRANT_GRPC_PORT=6334

# =============================================================================
# NEO4J KNOWLEDGE GRAPH
# =============================================================================
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j

# =============================================================================
# OLLAMA LOCAL LLM
# =============================================================================
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL_MEDICAL=meditron:7b
OLLAMA_MODEL_GENERAL=llama3.1:8b

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
APP_NAME=irStudy Medical Education Platform
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
PORT=8000
HOST=0.0.0.0
RELOAD=true

# =============================================================================
# SECURITY SETTINGS (CRITICAL)
# =============================================================================
# Generate JWT secret with: openssl rand -hex 32
JWT_SECRET_KEY=__GENERATE_ME__
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# =============================================================================
# CELERY TASK QUEUE
# =============================================================================
CELERY_BROKER_URL=redis://:__SECRET__@redis:6379/0
CELERY_RESULT_BACKEND=redis://:__SECRET__@redis:6379/0
CELERY_WORKER_CONCURRENCY=4

# =============================================================================
# MONITORING
# =============================================================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
FLOWER_PORT=5555

# =============================================================================
# MEDICAL EDUCATION SETTINGS
# =============================================================================
MCQ_PER_PAGE=20
OSCE_PER_PAGE=10
SPACED_REPETITION_ALGORITHM=SM2
DEFAULT_STUDY_PLAN_DURATION_DAYS=90

# =============================================================================
# RAG SYSTEM
# =============================================================================
RAG_TOP_K_RESULTS=5
RAG_SIMILARITY_THRESHOLD=0.7
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=50

# =============================================================================
# AUSTRALIAN MEDICAL CONTEXT
# =============================================================================
MEDICAL_REGION=australia
EMERGENCY_NUMBER=000
DRUG_TERMINOLOGY=australian
UNIT_SYSTEM=SI
