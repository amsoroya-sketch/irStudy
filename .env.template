# Medical Resources Download Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git - it's in .gitignore

# NCBI API Key (required for StatPearls downloads)
# Get your free API key at: https://www.ncbi.nlm.nih.gov/account/settings/
export NCBI_API_KEY='your_ncbi_api_key_here'

# Download directory (external drive recommended for 25-85 GB storage)
export MEDICAL_DOWNLOAD_DIR='/mnt/data/medical_resources'

# Project root directory
export MEDICAL_PROJECT_ROOT='/home/dev/Development/irStudy'

# Email for notifications (optional)
export ALERT_EMAIL='your-email@example.com'

# Webhook URL for Slack/Discord notifications (optional)
export ALERT_WEBHOOK_URL='https://hooks.slack.com/services/YOUR/WEBHOOK/URL'

# ============================================================
# MIGRATION INSTRUCTIONS
# ============================================================
# After creating .env with your secrets, migrate to encrypted storage:
#
# 1. Run migration:
#    python3 scripts/lib/secret_manager.py migrate --env-file .env
#
# 2. Verify secrets:
#    python3 scripts/lib/secret_manager.py list
#
# 3. Test retrieval:
#    python3 scripts/lib/secret_manager.py get --name NCBI_API_KEY
#
# 4. Remove .env or keep as backup (already in .gitignore)
#
# Your secrets are now encrypted in ~/.medical_resources/secrets.enc
# ============================================================
