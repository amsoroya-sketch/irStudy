# Kimi API Configuration (FREE Alternative to Claude)
KIMI_API_KEY=your_kimi_api_key_here
KIMI_BASE_URL=https://api.moonshot.cn/v1

# AI Validation Settings
AI_PROVIDER=kimi  # Options: 'claude' or 'kimi'
AI_VALIDATION_ENABLED=true
AI_VALIDATION_TIMEOUT=10

# Database
DATABASE_URL=postgresql://emr_user:emr_pass@localhost:5432/emr_practice

# JWT
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=http://localhost:5174

# Optional: Claude API (only if using Claude)
ANTHROPIC_API_KEY=
