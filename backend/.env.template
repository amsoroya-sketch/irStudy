# irStudy Medical Education Platform - Backend Environment Configuration
# Copy this file to backend/.env and replace placeholder values
# SECURITY: NEVER commit .env to Git - it contains sensitive credentials

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
ENV=development
DEBUG=True
LOG_LEVEL=INFO
APP_NAME=irStudy Medical Education Platform
APP_VERSION=1.0.0

# Secret key for JWT token signing (generate with: openssl rand -hex 32)
SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32

# JWT token expiration (seconds)
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# API prefix
API_V1_PREFIX=/api/v1

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# PostgreSQL connection
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=irstudy_medical
DATABASE_USER=postgres
# Note: DATABASE_PASSWORD loaded from Docker secret /run/secrets/db_password

# Database pool settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=30
DB_ECHO=False

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# Note: REDIS_PASSWORD loaded from Docker secret /run/secrets/redis_password

# Cache TTL (seconds)
CACHE_DEFAULT_TTL=3600
CACHE_MCQ_TTL=86400
CACHE_OSCE_TTL=86400

# ============================================================================
# QDRANT VECTOR DATABASE
# ============================================================================
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=medical_knowledge
QDRANT_VECTOR_SIZE=768
# Note: QDRANT_API_KEY loaded from Docker secret /run/secrets/qdrant_api_key

# ============================================================================
# NEO4J KNOWLEDGE GRAPH
# ============================================================================
NEO4J_URI=bolt://neo4j:7687
NEO4J_DATABASE=neo4j
# Note: NEO4J_AUTH loaded from Docker secret /run/secrets/neo4j_auth (format: neo4j/password)

# ============================================================================
# LLM API CONFIGURATION
# ============================================================================
# OpenAI API (for GPT-4, GPT-4o, embeddings)
# Note: OPENAI_API_KEY loaded from Docker secret /run/secrets/openai_api_key
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.7

# Anthropic API (for Claude 3.5 Sonnet)
# Note: ANTHROPIC_API_KEY loaded from Docker secret /run/secrets/anthropic_api_key
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TEMPERATURE=0.7

# Ollama local LLM endpoint
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_DEFAULT_MODEL=meditron:7b

# ============================================================================
# MEDICAL MODELS & RAG CONFIGURATION
# ============================================================================
# Primary medical reasoning model (Ollama local)
MEDICAL_MODEL=meditron:7b

# Fallback models
QA_MODEL=llama3.1:8b
CLINICAL_REASONING_MODEL=meditron:7b

# Embedding model for medical content
EMBEDDING_MODEL=pritamdeka/S-PubMedBert-MS-MARCO

# RAG search configuration
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.65
RAG_USE_RERANKING=True

# ============================================================================
# CELERY TASK QUEUE
# ============================================================================
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=application/json
CELERY_TIMEZONE=Australia/Sydney

# Celery worker concurrency
CELERY_WORKER_CONCURRENCY=4
CELERY_WORKER_MAX_TASKS_PER_CHILD=100

# ============================================================================
# EMAIL CONFIGURATION (Optional)
# ============================================================================
SMTP_ENABLED=False
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-password
SMTP_TLS=True
SMTP_FROM=noreply@irstudy.com
SMTP_FROM_NAME=irStudy Platform

# ============================================================================
# FILE STORAGE
# ============================================================================
UPLOAD_DIR=/app/uploads
UPLOAD_MAX_SIZE_MB=10
ALLOWED_UPLOAD_EXTENSIONS=pdf,png,jpg,jpeg,mp3,wav

# Medical images storage
MEDICAL_IMAGES_DIR=/app/data/images
ECG_IMAGES_DIR=/app/data/ecg_images
XRAY_IMAGES_DIR=/app/data/xray_images

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_ENABLED=True
RATE_LIMIT_STRATEGY=sliding-window

# Public endpoints (no auth)
RATE_LIMIT_ANONYMOUS_PER_MINUTE=20
RATE_LIMIT_ANONYMOUS_PER_HOUR=100

# Authenticated endpoints
RATE_LIMIT_USER_PER_MINUTE=60
RATE_LIMIT_USER_PER_HOUR=1000

# AI endpoints (expensive operations)
RATE_LIMIT_AI_PER_MINUTE=10
RATE_LIMIT_AI_PER_HOUR=100

# ============================================================================
# HIPAA COMPLIANCE SETTINGS
# ============================================================================
# PHI encryption at rest
ENCRYPTION_ENABLED=True
ENCRYPTION_ALGORITHM=AES-256-GCM

# Audit logging
AUDIT_LOG_ENABLED=True
AUDIT_LOG_FILE=/app/logs/audit.log
AUDIT_LOG_RETENTION_DAYS=365

# Session configuration
SESSION_SECURE_COOKIES=True
SESSION_HTTPONLY_COOKIES=True
SESSION_SAMESITE=strict
SESSION_TIMEOUT_SECONDS=900

# Password policy
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=True
PASSWORD_REQUIRE_LOWERCASE=True
PASSWORD_REQUIRE_DIGITS=True
PASSWORD_REQUIRE_SPECIAL=True
PASSWORD_HISTORY=5

# Account lockout
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================
# Prometheus metrics
METRICS_ENABLED=True
METRICS_PATH=/metrics

# Sentry error tracking (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Application logging
LOG_FORMAT=json
LOG_FILE=/app/logs/app.log
LOG_ROTATION_SIZE_MB=100
LOG_RETENTION_DAYS=30

# ============================================================================
# TESTING & DEVELOPMENT
# ============================================================================
# Test database (separate from production)
TEST_DATABASE_URL=postgresql://postgres:test@localhost:5432/irstudy_test

# Enable debug features (development only)
DEBUG_TOOLBAR=True
PROFILING_ENABLED=False

# Seed data for testing
LOAD_SAMPLE_DATA=True

# ============================================================================
# AUSTRALIAN MEDICAL STANDARDS
# ============================================================================
# Geographic region (affects drug names, units, emergency numbers)
MEDICAL_REGION=australia
MEDICAL_SPELLING=australian
EMERGENCY_NUMBER=000

# Therapeutic Guidelines
ETG_VERSION=2024
ETG_BASE_URL=https://tg.org.au

# PBS (Pharmaceutical Benefits Scheme)
PBS_DATABASE_ENABLED=False
PBS_DATABASE_URL=

# MBS (Medicare Benefits Schedule)
MBS_DATABASE_ENABLED=False
MBS_DATABASE_URL=

# AHPRA Standards
AHPRA_COMPLIANCE_CHECK=True

# ============================================================================
# AGENT OS INTEGRATION
# ============================================================================
AGENT_OS_ENABLED=True
AGENT_REGISTRY_PATH=/.claude/skills/skills-registry.json
AGENT_MAX_CONCURRENT_TASKS=5

# Medical expert agents
MEDICAL_AGENTS_ENABLED=True
MEDICAL_AGENTS_DIR=/app/src/agents/medical

# ============================================================================
# FEATURE FLAGS
# ============================================================================
# Core features
FEATURE_MCQ_GENERATION=True
FEATURE_OSCE_PRACTICE=True
FEATURE_FLASHCARDS=True
FEATURE_PROGRESS_TRACKING=True

# Advanced features (Week 2+)
FEATURE_OSCE_SIMULATION=False
FEATURE_EMR_PRACTICE=False
FEATURE_MOBILE_APP=False

# AI features (Week 3+)
FEATURE_AI_PATIENT=False
FEATURE_AI_EXAMINER=False
FEATURE_CLINICAL_DECISION_SUPPORT=False

# ============================================================================
# PERFORMANCE TUNING
# ============================================================================
# Uvicorn workers
UVICORN_WORKERS=4
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000

# Request timeouts
REQUEST_TIMEOUT_SECONDS=30
LONG_RUNNING_TASK_TIMEOUT_SECONDS=300

# Connection pool
MAX_CONNECTIONS=100
KEEPALIVE_TIMEOUT_SECONDS=65

# ============================================================================
# CONTENT GENERATION SETTINGS
# ============================================================================
# MCQ generation
MCQ_MIN_OPTIONS=4
MCQ_MAX_OPTIONS=5
MCQ_REQUIRE_EXPLANATION=True
MCQ_REQUIRE_CITATION=True

# OSCE generation
OSCE_MIN_DURATION_MINUTES=8
OSCE_MAX_DURATION_MINUTES=12
OSCE_REQUIRE_RUBRIC=True

# Content validation
VALIDATION_AUSTRALIAN_TERMINOLOGY=True
VALIDATION_REQUIRE_CITATIONS=True
VALIDATION_REQUIRE_PAGE_NUMBERS=True
VALIDATION_MIN_CONFIDENCE_SCORE=0.65

# ============================================================================
# BACKUP & DISASTER RECOVERY
# ============================================================================
# Database backups
BACKUP_ENABLED=True
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_DIR=/app/backups

# Point-in-time recovery
PITR_ENABLED=True
WAL_ARCHIVING=True
