              "rag_confidence": 0.9123,
              "source_type": "textbook",
              "source_category": "gp_primary_care",
              "qdrant_point_id": "8a4b5c6d-7e8f-9a0b-1c2d-3e4f5a6b7c8d",
              "query_used": "adrenaline first-line anaphylaxis timing",
              "retrieved_at": "2026-03-16T10:45:25Z"
            }
          ]
        }
      ],
      "fracp_reviews": [
        {
          "reviewer_name": "Dr Emma Roberts",
