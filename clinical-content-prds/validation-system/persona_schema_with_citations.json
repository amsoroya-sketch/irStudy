            "rag_confidence": 0.7823,
            "source_type": "textbook",
            "source_category": "clinical_skills",
            "qdrant_point_id": "2c3d4e5f-6a7b-8c9d-0e1f-2a3b4c5d6e7f",
            "query_used": "bilateral wheeze anaphylaxis",
            "retrieved_at": "2026-03-16T10:45:24Z"
          }
        ]
      },
