# Copy to ".env" in the repo root before running the production overlay:
#   cp .env.deploy.example .env   &&   edit values
# docker compose auto-loads .env. Do NOT commit the real .env (it is gitignored).

# --- Public address / TLS ---------------------------------------------------
# Real domain -> Caddy auto-provisions a Let's Encrypt cert and serves HTTPS:
#   SITE_ADDRESS=app.example.com
# Behind a Cloudflare Tunnel (TLS terminated upstream), keep plain HTTP:
#   SITE_ADDRESS=:80
SITE_ADDRESS=:80

# --- Backend host allowlist (TrustedHostMiddleware, ENV=production) ----------
# Comma-separated public hostnames. For the real domain:
#   ALLOWED_HOSTS=app.example.com
# For a throwaway quick tunnel (random *.trycloudflare.com host), use "*":
ALLOWED_HOSTS=*

# --- CORS (usually leave empty) --------------------------------------------
# The SPA is same-origin with the API behind Caddy, so CORS is not exercised.
# Only set this if you split the frontend onto a different origin.
CORS_ORIGINS=
