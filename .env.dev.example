# AMC Clinical Exam Simulation - Development Environment Variables
# v2.0 Enhanced Architecture - Security-First Configuration

# ==============================================================================
# CRITICAL SECURITY NOTE
# ==============================================================================
# Per PROJECT_CONSTRAINTS.md constraint 3 (security-configuration):
# - Only VAULT_ADDR and VAULT_TOKEN should be in this file
# - ALL other secrets MUST be stored in HashiCorp Vault
# - Copy this file to .env.dev and fill in the values
# - NEVER commit .env.dev to git (.gitignore should block it)
# ==============================================================================

# HashiCorp Vault Connection (ONLY secrets allowed in .env)
VAULT_ADDR=http://localhost:8200
VAULT_ROOT_TOKEN=dev-only-token-change-in-prod

# Database Credentials (used ONLY for docker-compose, app fetches from Vault)
POSTGRES_USER=amc_user
POSTGRES_PASSWORD=CHANGE_ME_dev_postgres_password_$(openssl rand -hex 16)
POSTGRES_DB=amc_simulation

# Redis Password (used ONLY for docker-compose, app fetches from Vault)
REDIS_PASSWORD=CHANGE_ME_dev_redis_password_$(openssl rand -hex 16)

# ==============================================================================
# IMPORTANT: Generate Strong Passwords
# ==============================================================================
# Before first run, generate strong random passwords:
#
#   export POSTGRES_PASSWORD=$(openssl rand -base64 32)
#   export REDIS_PASSWORD=$(openssl rand -base64 32)
#
# Then run: python backend/scripts/setup_vault.py
# This will store the passwords in Vault and the app will fetch them from there
# ==============================================================================
