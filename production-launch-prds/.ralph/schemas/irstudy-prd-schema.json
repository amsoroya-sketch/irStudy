{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://irstudy.com/schemas/prd.json",
  "title": "irStudy PRD Schema",
  "description": "Extended PRD schema for irStudy medical education platform with phase structure, agents, and skills",
  "type": "object",
  "required": [
    "$schema",
    "id",
    "title",
    "phase",
    "component",
    "agent",
    "prompt",
    "acceptance_criteria",
    "validations"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Schema reference",
      "const": ".ralph/schemas/irstudy-prd-schema.json"
    },
    "id": {
      "type": "string",
      "pattern": "^PRD-PHASE[0-9]+-[0-9]+-[A-Z-]+$",
      "description": "Unique PRD identifier (e.g., PRD-PHASE1-001-WEBSOCKET-CHAT-UI)",
      "examples": ["PRD-PHASE1-001-WEBSOCKET-CHAT-UI"]
    },
    "title": {
      "type": "string",
      "minLength": 10,
      "maxLength": 200,
      "description": "Human-readable PRD title",
      "examples": ["WebSocket Chat Interface for AI OSCE Sessions"]
    },
    "description": {
      "type": "string",
      "description": "Brief description of the feature"
    },
    "phase": {
      "type": "object",
      "required": ["number", "name"],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8,
          "description": "Phase number (1-8)"
        },
        "name": {
          "type": "string",
          "enum": [
            "Frontend Core",
            "Scoring System",
            "Spaced Repetition",
            "EMR Integration",
            "Content Generation",
            "Mock Exam",
            "Testing & Security",
            "UI Polish"
          ],
          "description": "Phase name"
        },
        "description": {
          "type": "string",
          "description": "Phase description"
        }
      }
    },
    "component": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Component name (e.g., 'OSCE Chat Interface', 'Scoring Engine')"
        },
        "type": {
          "type": "string",
          "enum": ["frontend", "backend", "database", "testing", "integration", "content"],
          "description": "Component type"
        },
        "subcomponents": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of subcomponents"
        }
      }
    },
    "agent": {
      "type": "object",
      "required": ["name", "file"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Agent name (must match agent file)",
          "enum": [
            "react-frontend-developer",
            "python-backend-developer",
            "testing-qa-specialist",
            "clinical-documentation-expert",
            "history-taking-expert",
            "physical-examination-expert"
          ]
        },
        "file": {
          "type": "string",
          "pattern": "^\\.claude/agents/.+\\.md$",
          "description": "Path to agent file relative to project root",
          "examples": [".claude/agents/react-frontend-developer.md"]
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "file"],
            "properties": {
              "name": {
                "type": "string",
                "description": "Skill name"
              },
              "file": {
                "type": "string",
                "pattern": "^\\.claude/skills/.+/SKILL\\.md$",
                "description": "Path to skill file"
              }
            }
          },
          "description": "Skills required for this PRD"
        }
      }
    },
    "priority": {
      "type": "string",
      "enum": ["P0", "P1", "P2", "P3"],
      "default": "P2",
      "description": "Priority level (P0 = critical, P3 = low)"
    },
    "risk_level": {
      "type": "string",
      "enum": ["HIGH", "MEDIUM", "LOW"],
      "default": "MEDIUM",
      "description": "Risk level for approval gates"
    },
    "estimated_hours": {
      "type": "number",
      "minimum": 1,
      "maximum": 100,
      "description": "Estimated effort in hours"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^PRD-PHASE[0-9]+-[0-9]+-[A-Z-]+$"
      },
      "description": "List of PRD IDs this depends on"
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^PRD-PHASE[0-9]+-[0-9]+-[A-Z-]+$"
      },
      "description": "List of PRD IDs blocked by this"
    },
    "prompt": {
      "type": "string",
      "minLength": 100,
      "description": "Detailed prompt for the agent including requirements, constraints, and implementation steps"
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string",
        "minLength": 10
      },
      "description": "List of acceptance criteria that must be met"
    },
    "validations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "description", "blocking"],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "compilation",
              "test_suite",
              "integration_test",
              "e2e_test",
              "code_coverage",
              "security_scan",
              "accessibility_audit",
              "performance_test"
            ]
          },
          "description": {
            "type": "string"
          },
          "blocking": {
            "type": "boolean",
            "description": "If true, PRD cannot complete if this validation fails"
          },
          "command": {
            "type": "string",
            "description": "Shell command to run validation"
          },
          "min_coverage": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "description": "Minimum code coverage percentage (for code_coverage type)"
          },
          "on_failure": {
            "type": "string",
            "enum": ["fail", "warn", "invoke_fix_loop"],
            "default": "fail"
          }
        }
      }
    },
    "technical_design": {
      "type": "object",
      "properties": {
        "architecture": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "files_to_create": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "files_to_modify": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "api_endpoints": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]
              },
              "path": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          }
        },
        "database_changes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["create_table", "alter_table", "create_index", "migration"]
              },
              "description": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "context": {
      "type": "object",
      "properties": {
        "related_prds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "documentation": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "external_references": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            }
          }
        }
      }
    }
  }
}
