    },

    {
        "id": "WEEK3-RESP-108",
        "topic": "Compression Ultrasound Interpretation",
        "question": "A 55-year-old woman undergoes compression duplex ultrasound for suspected DVT. The report states: 'Non-compressible thrombus in the left popliteal vein extending into the femoral vein. No flow on Doppler assessment. Calf veins patent.' What is the most appropriate interpretation and management?",
        "options": {
            "a": "Isolated calf DVT; observation without anticoagulation appropriate",
            "b": "Proximal DVT (popliteal and femoral veins); commence therapeutic anticoagulation",
            "c": "Superficial thrombophlebitis; NSAIDs and compression stockings",
            "d": "Non-diagnostic ultrasound; repeat in 48 hours",
            "e": "Normal ultrasound; DVT excluded"
        },
        "correct_answer": "b",
        "explanation": "This is PROXIMAL DVT involving popliteal and femoral veins (deep veins above the calf). Proximal DVT has high risk of PE (10-20%) and requires therapeutic anticoagulation. Non-compressibility on ultrasound with absent Doppler flow confirms thrombosis. The fact that calf veins are patent doesn't change management - the proximal DVT requires treatment.",
        "rationale": {
            "a": "Incorrect - this is proximal DVT (popliteal + femoral), NOT isolated calf DVT; anticoagulation mandatory",
            "b": "CORRECT - Popliteal and femoral veins are proximal deep veins; non-compressible thrombus = DVT requiring therapeutic anticoagulation",
            "c": "Incorrect - popliteal and femoral veins are DEEP veins, not superficial; this is DVT, not superficial thrombophlebitis",
            "d": "Incorrect - ultrasound is diagnostic (non-compressible vein with thrombus); no need to repeat",
            "e": "Incorrect - non-compressible thrombus in popliteal and femoral veins is clearly ABNORMAL (DVT diagnosed)"
        },
        "key_learning_points": [
            "Proximal DVT: Popliteal, femoral, common femoral, iliac veins (above the knee)",
            "Ultrasound signs of DVT: (1) Non-compressible vein, (2) Visible thrombus, (3) Absent Doppler flow",
            "Proximal DVT: HIGH PE risk (10-20%), REQUIRES therapeutic anticoagulation",
            "Isolated calf DVT: Lower PE risk (<5%), anticoagulation depends on risk factors",
            "Anticoagulation reduces PE risk from 50% to <5%"
        ],
        "tags": ["respiratory", "DVT", "ultrasound", "proximal DVT", "anticoagulation", "week3"],
