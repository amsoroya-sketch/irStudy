    {
        "id": "WEEK3-RESP-112",
        "topic": "Unprovoked VTE Risk Stratification",
        "question": "A 42-year-old woman presents with unprovoked proximal DVT (no surgery, trauma, oestrogen, immobilisation, or long-haul travel). Thrombophilia screen is negative. After 6 months of anticoagulation, she asks about stopping treatment. What is her approximate annual recurrence risk if anticoagulation is stopped?",
        "options": {
            "a": "1-2% per year (low risk)",
            "b": "5-7% per year (moderate risk)",
            "c": "10-15% per year (high risk)",
            "d": "20-30% per year (very high risk)",
            "e": "50% within first year (extremely high risk)"
        },
        "correct_answer": "c",
        "explanation": "Unprovoked VTE has approximately 10% annual recurrence risk after stopping anticoagulation. Cumulative 5-year recurrence ~30%. Men have slightly higher risk than women (~15% vs 8% annually). This high recurrence risk is why indefinite anticoagulation is CONSIDERED (not mandated) for unprovoked VTE. Must balance recurrence risk vs bleeding risk (1-2%/year major bleeding).",
        "rationale": {
            "a": "Incorrect - 1-2% is recurrence risk ON anticoagulation, not OFF; or risk for provoked VTE after stopping",
            "b": "Incorrect - underestimates recurrence risk; unprovoked VTE recurrence is ~10%/year (5-7% would be intermediate)",
            "c": "CORRECT - Unprovoked VTE recurrence: ~10% per year off anticoagulation (women ~8%, men ~12-15%), cumulative 30% at 5 years",
            "d": "Incorrect - overestimates annual risk; 20-30% is cumulative risk over several years, not annual",
            "e": "Incorrect - vastly overestimates; even very high-risk patients don't have 50% first-year recurrence"
        },
