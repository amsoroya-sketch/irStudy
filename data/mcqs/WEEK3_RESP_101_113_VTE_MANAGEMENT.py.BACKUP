    {
        "id": "WEEK3-RESP-110",
        "topic": "Duration of Anticoagulation for VTE",
        "question": "A 35-year-old woman completed 3 months of anticoagulation for unprovoked proximal DVT. She has no bleeding risk factors and no thrombophilia identified. What is the most appropriate management according to Australian guidelines?",
        "options": {
            "a": "Stop anticoagulation after 3 months (treatment complete)",
            "b": "Continue anticoagulation for additional 3 months (total 6 months), then stop",
            "c": "Continue anticoagulation indefinitely (lifelong)",
            "d": "Continue anticoagulation for 6-12 months, then reassess risk-benefit of continuing indefinitely",
            "e": "Switch to aspirin for long-term prophylaxis"
        },
        "correct_answer": "d",
        "explanation": "Unprovoked VTE (no clear trigger like surgery/trauma/immobilisation) has 30% recurrence risk at 5 years. After 3 months initial treatment, continue to 6-12 months minimum, then reassess. If low bleeding risk and good compliance, consider indefinite anticoagulation (recurrence risk ~1.5%/year on treatment vs 10%/year off treatment). This is shared decision-making with patient.",
        "rationale": {
            "a": "Incorrect - 3 months insufficient for unprovoked VTE; minimum 6 months recommended (high recurrence risk if stopped early)",
            "b": "Incorrect - while 6 months minimum is correct, decision to stop vs continue indefinitely should be individualized (not automatic stop)",
            "c": "Incorrect - 'indefinite' is option but not mandatory; requires shared decision-making considering bleeding risk, patient preference",
            "d": "CORRECT - Unprovoked VTE: Treat 6-12 months minimum, then reassess for indefinite anticoagulation (balance recurrence risk vs bleeding risk)",
            "e": "Incorrect - aspirin reduces VTE recurrence by only 30% (vs 80-90% with anticoagulation); not adequate if continuing prophylaxis"
        },
        "key_learning_points": [
            "Anticoagulation duration for VTE:",
            "• Provoked (surgery, trauma, oestrogen): 3 months",
            "• Unprovoked (no clear trigger): 6-12 months minimum, CONSIDER indefinite",
            "• Cancer-associated: Indefinite (or until cancer resolved)",
            "• Recurrent unprovoked: Indefinite (strong indication)",
            "Unprovoked VTE recurrence risk: 30% at 5 years if stopped, 3-5% at 5 years if continued",
            "Balance: Recurrence risk vs bleeding risk (~1-2%/year major bleeding on anticoagulation)"
        ],
