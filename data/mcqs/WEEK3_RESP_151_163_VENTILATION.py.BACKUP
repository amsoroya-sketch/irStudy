# MCQ 153: Obesity Hypoventilation Syndrome
MCQ_153 = {
    "question_id": "WEEK3_RESP_153",
    "topic": "Ventilation & Pleural Disease",
    "subtopic": "Obesity Hypoventilation Syndrome",
