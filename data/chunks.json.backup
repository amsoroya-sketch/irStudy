      "edition": "8th"
    }
  },
  {
    "text": "before\n\nminutes afterwards\n\nhours afterwards\n\ndays afterwards\n\nweeks afterwards\n\nroe BSy\n",
    "metadata": {
      "source": "John Murtagh General Practice, 8th Edition.pdf",
      "page": 896,
      "chunk_index": 0,
      "total_chunks": 1,
      "type": "text",
