      "word_count": 50,
      "title": "John Murtagh General Practice",
      "author": "John",
      "year": "2020",
      "edition": "8th"
    }
  },
  {
    "text": "FIGURE 30.16  Coronary artery bypass grafting to relieve coronary obstruction\n",
    "metadata": {
      "source": "John Murtagh General Practice, 8th Edition.pdf",
      "page": 892,
      "chunk_index": 0,
      "total_chunks": 1,
      "type": "text",
      "char_count": 78,
