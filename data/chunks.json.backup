      "edition": "8th"
    }
  },
  {
    "text": "",
    "metadata": {
      "source": "John Murtagh General Practice, 8th Edition.pdf",
      "page": 3067,
      "chunk_index": 0,
      "total_chunks": 1,
      "type": "text",
      "char_count": 0,
      "word_count": 0,
      "title": "John Murtagh General Practice",
