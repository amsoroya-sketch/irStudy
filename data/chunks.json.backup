  {
    "text": "ECG Rhythm Interpretation\nModule I\nECG Basics\n",
    "metadata": {
      "source": "ECG book.pdf",
      "page": 1,
      "chunk_index": 0,
      "total_chunks": 1,
      "type": "text",
      "char_count": 46,
      "word_count": 7,
