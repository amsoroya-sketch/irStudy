      "word_count": 144,
      "title": "Talley & Connor's Clinical Examination",
      "author": "Talley & Connor",
      "year": "2020",
      "edition": ""
    }
  },
  {
    "text": "Figure 10.2 The anatomy of the thyroid\n\n",
    "metadata": {
      "source": "Clinical Examination-Talley & Connor-pdf.pdf",
      "page": 689,
      "chunk_index": 0,
      "total_chunks": 1,
      "type": "text",
      "char_count": 40,
