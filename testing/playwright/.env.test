# Test Environment Variables for Playwright E2E Tests
# AMC Clinical Exam Simulation

# Application URLs
BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8001/api/v1

# Test User Credentials
# Student Account
STUDENT_EMAIL=student@test.com
STUDENT_PASSWORD=Student123!@#
STUDENT_FULLNAME=Test Student

# Educator Account
EDUCATOR_EMAIL=educator@test.com
EDUCATOR_PASSWORD=Educator123!@#
EDUCATOR_FULLNAME=Test Educator

# Admin Account
ADMIN_EMAIL=admin@test.com
ADMIN_PASSWORD=Admin123!@#
ADMIN_FULLNAME=Test Admin

# Test Configuration
TEST_TIMEOUT=60000
ACTION_TIMEOUT=10000
NAVIGATION_TIMEOUT=30000

# CI/CD Configuration
CI=false
HEADLESS=true
PARALLEL_WORKERS=4

# Screenshot & Video
SCREENSHOT_ON_FAILURE=true
VIDEO_ON_FAILURE=true
TRACE_ON_RETRY=true

# Accessibility Testing
A11Y_WCAG_LEVEL=AA
A11Y_TAGS=wcag2a,wcag2aa,wcag21a,wcag21aa

# Mock Data
USE_MOCK_API=true
MOCK_DELAY_MS=100

# Debugging
DEBUG=false
SLOWMO_MS=0
