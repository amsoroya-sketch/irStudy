/**
 * OSCE Video Resources Integration Tests
 * ========================================
 *
 * Comprehensive testing of the NEW video resources feature for OSCE stations
 * Tests essential videos, supplementary videos, responsive design, accessibility, and edge cases
 *
 * Total: 65 exhaustive test cases
 *
 * Test Data: Uses TEST-CARDIO-VIDEO-001, TEST-RESP-VIDEO-001, TEST-NEURO-HISTORY-001, TEST-ABDO-VIDEO-001
 */

import { test, expect, Page } from '@playwright/test';
import { TEST_USERS } from '../../../utils/test-data/users';

test.describe('OSCE Video Resources - Essential Videos Section', () => {
  let page: Page;

  test.beforeEach(async ({ page: testPage }) => {
    page = testPage;
    // Login as student
    await page.goto('/login');

    // Fill and blur email to trigger validation
    const emailInput = page.locator('input[name="email"]');
    await emailInput.fill(TEST_USERS.STUDENT.email);
    await emailInput.blur();

    // Fill and blur password to trigger validation
    const passwordInput = page.locator('input[name="password"]');
    await passwordInput.fill(TEST_USERS.STUDENT.password);
    await passwordInput.blur();

    // Wait for button to be enabled, then click
    const submitButton = page.locator('button[type="submit"]');
    await expect(submitButton).toBeEnabled();
    await submitButton.click();

    // Wait for redirect to dashboard
    await expect(page).toHaveURL(/\/dashboard/);
  });

  test('should display essential videos section header', async () => {
    // Navigate to OSCE with videos
    await page.goto('/osces/TEST-CARDIO-VIDEO-001');

    // Check section header is visible
    const sectionHeader = page.locator('h2:has-text("Essential Video Demonstrations")');
    await expect(sectionHeader).toBeVisible();
    await expect(sectionHeader).toHaveText(/Essential Video Demonstrations/i);
  });

  test('should display all essential videos (up to 4)', async () => {
    await page.goto('/osces/TEST-CARDIO-VIDEO-001');

    // This OSCE has 2 essential videos
    const videoCards = page.locator('[data-testid="essential-video-card"]');
    await expect(videoCards).toHaveCount(2);
  });

  test('should display video title correctly', async () => {
    await page.goto('/osces/TEST-CARDIO-VIDEO-001');

    const firstVideoTitle = page.locator('[data-testid="essential-video-card"]').first().locator('[data-testid="video-title"]');
    await expect(firstVideoTitle).toBeVisible();
    await expect(firstVideoTitle).toHaveText(/Cardiovascular Examination/i);
  });

  test('should display video source', async () => {
    await page.goto('/osces/TEST-CARDIO-VIDEO-001');

    const firstVideoSource = page.locator('[data-testid="essential-video-card"]').first().locator('[data-testid="video-source"]');
    await expect(firstVideoSource).toBeVisible();
    await expect(firstVideoSource).toHaveText(/Stanford Medicine 25/i);
  });

  test('should display video duration', async () => {
    await page.goto('/osces/TEST-CARDIO-VIDEO-001');

    const firstVideoDuration = page.locator('[data-testid="essential-video-card"]').first().locator('[data-testid="video-duration"]');
    await expect(firstVideoDuration).toBeVisible();
    await expect(firstVideoDuration).toHaveText(/10 min/i);
  });

  test('should display video focus description', async () => {
    await page.goto('/osces/TEST-CARDIO-VIDEO-001');

    const firstVideoFocus = page.locator('[data-testid="essential-video-card"]').first().locator('[data-testid="video-focus"]');
    await expect(firstVideoFocus).toBeVisible();
    await expect(firstVideoFocus).toHaveText(/Complete systematic cardiac examination/i);
  });

  test('should display "why recommended" text', async () => {
    await page.goto('/osces/TEST-CARDIO-VIDEO-001');

    const firstVideoWhy = page.locator('[data-testid="essential-video-card"]').first().locator('[data-testid="video-why-recommended"]');
    await expect(firstVideoWhy).toBeVisible();
    await expect(firstVideoWhy).toHaveText(/Gold standard demonstration/i);
  });

  test('should display Australian relevance note', async () => {
    await page.goto('/osces/TEST-CARDIO-VIDEO-001');

    const firstVideoRelevance = page.locator('[data-testid="essential-video-card"]').first().locator('[data-testid="video-australian-relevance"]');
    await expect(firstVideoRelevance).toBeVisible();
    await expect(firstVideoRelevance).toHaveText(/AMC Clinical exam/i);
  });

  test('should display video thumbnail or icon', async () => {
    await page.goto('/osces/TEST-CARDIO-VIDEO-001');

    const firstVideoIcon = page.locator('[data-testid="essential-video-card"]').first().locator('[data-testid="video-icon"]');
    // Icon should be visible (either thumbnail or video play icon)
    await expect(firstVideoIcon).toBeVisible();
  });

  test('should have HTTPS-only video URLs', async () => {
    await page.goto('/osces/TEST-CARDIO-VIDEO-001');

    const firstVideoLink = page.locator('[data-testid="essential-video-card"]').first().locator('a[data-testid="video-link"]');
    const href = await firstVideoLink.getAttribute('href');
    expect(href).toMatch(/^https:\/\//);
  });

  test('should open video in new tab when clicked', async () => {
    await page.goto('/osces/TEST-CARDIO-VIDEO-001');

    const firstVideoLink = page.locator('[data-testid="essential-video-card"]').first().locator('a[data-testid="video-link"]');

    // Check target="_blank" attribute
    await expect(firstVideoLink).toHaveAttribute('target', '_blank');

    // Check rel="noopener noreferrer" for security
    await expect(firstVideoLink).toHaveAttribute('rel', /noopener/);
  });

  test('should display external link icon', async () => {
    await page.goto('/osces/TEST-CARDIO-VIDEO-001');

    const externalLinkIcon = page.locator('[data-testid="essential-video-card"]').first().locator('[data-testid="external-link-icon"]');
    await expect(externalLinkIcon).toBeVisible();
  });

  test('should verify trusted source - Stanford Medicine 25', async () => {
    await page.goto('/osces/TEST-CARDIO-VIDEO-001');

    const videoSource = page.locator('[data-testid="essential-video-card"]').first().locator('[data-testid="video-source"]');
    await expect(videoSource).toHaveText(/Stanford Medicine 25/i);

    const videoLink = page.locator('[data-testid="essential-video-card"]').first().locator('a[data-testid="video-link"]');
    const href = await videoLink.getAttribute('href');
    expect(href).toContain('stanfordmedicine25.stanford.edu');
  });

  test('should verify trusted source - Geeky Medics', async () => {
    await page.goto('/osces/TEST-CARDIO-VIDEO-001');

    const secondVideoSource = page.locator('[data-testid="essential-video-card"]').nth(1).locator('[data-testid="video-source"]');
    await expect(secondVideoSource).toHaveText(/Geeky Medics/i);

    const secondVideoLink = page.locator('[data-testid="essential-video-card"]').nth(1).locator('a[data-testid="video-link"]');
    const href = await secondVideoLink.getAttribute('href');
    expect(href).toContain('geekymedics.com');
  });

  test('should verify trusted source - Oxford Medical Education', async () => {
    // This is in supplementary videos, tested in next section
    // Skip for essential videos
  });

  test('should handle OSCE with 1 essential video', async () => {
    await page.goto('/osces/TEST-RESP-VIDEO-001');

    // This OSCE has only 1 essential video
    const videoCards = page.locator('[data-testid="essential-video-card"]');
    await expect(videoCards).toHaveCount(1);
  });

  test('should handle OSCE with 4 essential videos (maximum)', async () => {
    await page.goto('/osces/TEST-ABDO-VIDEO-001');

    // This OSCE has 4 essential videos (max allowed)
    const videoCards = page.locator('[data-testid="essential-video-card"]');
    await expect(videoCards).toHaveCount(4);
  });

  test('should NOT display essential videos section when OSCE has no videos', async () => {
    await page.goto('/osces/TEST-NEURO-HISTORY-001');

    // This OSCE has no video resources
    const sectionHeader = page.locator('h2:has-text("Essential Video Demonstrations")');
    await expect(sectionHeader).not.toBeVisible();
  });

  test('should show loading state while fetching videos', async () => {
    await page.goto('/osces/TEST-CARDIO-VIDEO-001', { waitUntil: 'domcontentloaded' });

    // Check for skeleton loader or loading spinner
    const loadingIndicator = page.locator('[data-testid="video-resources-loading"]');
    // May or may not be visible depending on network speed
    // Just verify it doesn't cause errors
  });

  test('should handle error state if video fetch fails', async () => {
    // Mock API to return error
    await page.route('**/api/v1/osces/TEST-CARDIO-VIDEO-001', route => {
      route.fulfill({ status: 500 });
    });

    await page.goto('/osces/TEST-CARDIO-VIDEO-001');

    // Should show error message
    const errorMessage = page.locator('[data-testid="video-resources-error"]');
    await expect(errorMessage).toBeVisible();
  });

  test('should support keyboard navigation (Tab to video links)', async () => {
    await page.goto('/osces/TEST-CARDIO-VIDEO-001');

    const firstVideoLink = page.locator('[data-testid="essential-video-card"]').first().locator('a[data-testid="video-link"]');

    // Tab to the link
    await page.keyboard.press('Tab');
    // Continue tabbing until we reach the video link
    let attempts = 0;
    while (!(await firstVideoLink.evaluate(el => el === document.activeElement)) && attempts < 20) {
      await page.keyboard.press('Tab');
      attempts++;
    }

    // Verify focus is on the link
    await expect(firstVideoLink).toBeFocused();
  });

  test('should open video when Enter key is pressed on focused link', async () => {
    await page.goto('/osces/TEST-CARDIO-VIDEO-001');

    const firstVideoLink = page.locator('[data-testid="essential-video-card"]').first().locator('a[data-testid="video-link"]');

    // Focus the link
    await firstVideoLink.focus();

    // Press Enter - would open in new tab (can't test actual opening, but verify it's an <a> tag)
    await expect(firstVideoLink).toHaveAttribute('href');
  });
});

test.describe('OSCE Video Resources - Supplementary Videos Section', () => {
  let page: Page;

  test.beforeEach(async ({ page: testPage }) => {
    page = testPage;
    // Login as student
    await page.goto('/login');

    // Fill and blur email to trigger validation
    const emailInput = page.locator('input[name="email"]');
    await emailInput.fill(TEST_USERS.STUDENT.email);
    await emailInput.blur();

    // Fill and blur password to trigger validation
    const passwordInput = page.locator('input[name="password"]');
    await passwordInput.fill(TEST_USERS.STUDENT.password);
    await passwordInput.blur();

    // Wait for button to be enabled, then click
    const submitButton = page.locator('button[type="submit"]');
    await expect(submitButton).toBeEnabled();
    await submitButton.click();

    // Wait for redirect to dashboard
    await expect(page).toHaveURL(/\/dashboard/);
  });

  test('should display supplementary videos section header', async () => {
    await page.goto('/osces/TEST-CARDIO-VIDEO-001');

    const sectionHeader = page.locator('h3:has-text("Supplementary Videos")');
    await expect(sectionHeader).toBeVisible();
  });

  test('should have supplementary videos collapsed by default', async () => {
    await page.goto('/osces/TEST-CARDIO-VIDEO-001');

    // Supplementary videos should be hidden initially
    const supplementaryVideos = page.locator('[data-testid="supplementary-videos-container"]');
    await expect(supplementaryVideos).not.toBeVisible();
  });

  test('should display "Show More" / expand button', async () => {
    await page.goto('/osces/TEST-CARDIO-VIDEO-001');

    const expandButton = page.locator('[data-testid="supplementary-videos-toggle"]');
    await expect(expandButton).toBeVisible();
    await expect(expandButton).toHaveText(/Show More|Expand/i);
  });

  test('should expand supplementary videos when "Show More" clicked', async () => {
    await page.goto('/osces/TEST-CARDIO-VIDEO-001');

    const expandButton = page.locator('[data-testid="supplementary-videos-toggle"]');
    await expandButton.click();

    // Supplementary videos container should now be visible
    const supplementaryVideos = page.locator('[data-testid="supplementary-videos-container"]');
    await expect(supplementaryVideos).toBeVisible();
  });

  test('should display supplementary video cards after expansion', async () => {
    await page.goto('/osces/TEST-CARDIO-VIDEO-001');

    const expandButton = page.locator('[data-testid="supplementary-videos-toggle"]');
    await expandButton.click();

    // Should show 1 supplementary video
    const videoCards = page.locator('[data-testid="supplementary-video-card"]');
    await expect(videoCards).toHaveCount(1);
  });

  test('should show same metadata for supplementary videos as essential videos', async () => {
    await page.goto('/osces/TEST-CARDIO-VIDEO-001');

    const expandButton = page.locator('[data-testid="supplementary-videos-toggle"]');
    await expandButton.click();

    const firstSupplementaryVideo = page.locator('[data-testid="supplementary-video-card"]').first();

    // Verify all metadata fields are present
    await expect(firstSupplementaryVideo.locator('[data-testid="video-title"]')).toBeVisible();
    await expect(firstSupplementaryVideo.locator('[data-testid="video-source"]')).toBeVisible();
    await expect(firstSupplementaryVideo.locator('[data-testid="video-duration"]')).toBeVisible();
    await expect(firstSupplementaryVideo.locator('[data-testid="video-focus"]')).toBeVisible();
    await expect(firstSupplementaryVideo.locator('[data-testid="video-why-recommended"]')).toBeVisible();
    await expect(firstSupplementaryVideo.locator('a[data-testid="video-link"]')).toBeVisible();
  });

  test('should change button text to "Show Less" / collapse after expansion', async () => {
    await page.goto('/osces/TEST-CARDIO-VIDEO-001');

    const toggleButton = page.locator('[data-testid="supplementary-videos-toggle"]');
    await toggleButton.click();

    // Button text should change
    await expect(toggleButton).toHaveText(/Show Less|Collapse/i);
  });

  test('should collapse supplementary videos when "Show Less" clicked', async () => {
    await page.goto('/osces/TEST-CARDIO-VIDEO-001');

    const toggleButton = page.locator('[data-testid="supplementary-videos-toggle"]');

    // Expand
    await toggleButton.click();
    let supplementaryVideos = page.locator('[data-testid="supplementary-videos-container"]');
    await expect(supplementaryVideos).toBeVisible();

    // Collapse
    await toggleButton.click();
    await expect(supplementaryVideos).not.toBeVisible();
  });

  test('should have smooth animation on expand/collapse', async () => {
    await page.goto('/osces/TEST-CARDIO-VIDEO-001');

    const toggleButton = page.locator('[data-testid="supplementary-videos-toggle"]');
    const container = page.locator('[data-testid="supplementary-videos-container"]');

    // Check if container has transition/animation CSS
    await toggleButton.click();

    // Container should have animation class or CSS transition
    const hasTransition = await container.evaluate(el => {
      const styles = window.getComputedStyle(el);
      return styles.transition !== 'none' || styles.animation !== 'none';
    });

    expect(hasTransition).toBeTruthy();
  });

  test('should NOT show supplementary section when OSCE has no supplementary videos', async () => {
    await page.goto('/osces/TEST-RESP-VIDEO-001');

    // This OSCE has only essential videos, no supplementary
    const sectionHeader = page.locator('h3:has-text("Supplementary Videos")');
    await expect(sectionHeader).not.toBeVisible();
  });

  test('should handle OSCE with 3 supplementary videos (maximum)', async () => {
    await page.goto('/osces/TEST-ABDO-VIDEO-001');

    const expandButton = page.locator('[data-testid="supplementary-videos-toggle"]');
    await expandButton.click();

    // This OSCE has 1 supplementary video (TEST data, but max is 3)
    const videoCards = page.locator('[data-testid="supplementary-video-card"]');
    await expect(videoCards).toHaveCount(1);
  });

  test('should toggle aria-expanded attribute on expand/collapse', async () => {
    await page.goto('/osces/TEST-CARDIO-VIDEO-001');

    const toggleButton = page.locator('[data-testid="supplementary-videos-toggle"]');

    // Initially collapsed
    await expect(toggleButton).toHaveAttribute('aria-expanded', 'false');

    // Expand
    await toggleButton.click();
    await expect(toggleButton).toHaveAttribute('aria-expanded', 'true');

    // Collapse
    await toggleButton.click();
    await expect(toggleButton).toHaveAttribute('aria-expanded', 'false');
  });
});

test.describe('OSCE Video Resources - Responsive Design', () => {
  test('should display videos in 2-column grid on desktop (1920x1080)', async ({ page }) => {
    await page.setViewportSize({ width: 1920, height: 1080 });

    await page.goto('/login');
    await page.fill('input[name="email"]', TEST_USERS.STUDENT.email);
    await page.fill('input[name="password"]', TEST_USERS.STUDENT.password);
    await page.click('button[type="submit"]');

    await page.goto('/osces/TEST-ABDO-VIDEO-001');

    // Essential videos container should use grid layout
    const videosContainer = page.locator('[data-testid="essential-videos-container"]');
    const gridDisplay = await videosContainer.evaluate(el => {
      return window.getComputedStyle(el).display;
    });

    expect(gridDisplay).toBe('grid');
  });

  test('should display videos in single column on tablet (768x1024)', async ({ page }) => {
    await page.setViewportSize({ width: 768, height: 1024 });

    await page.goto('/login');
    await page.fill('input[name="email"]', TEST_USERS.STUDENT.email);
    await page.fill('input[name="password"]', TEST_USERS.STUDENT.password);
    await page.click('button[type="submit"]');

    await page.goto('/osces/TEST-ABDO-VIDEO-001');

    // Videos should stack in single column on tablet
    const videosContainer = page.locator('[data-testid="essential-videos-container"]');
    const gridColumns = await videosContainer.evaluate(el => {
      return window.getComputedStyle(el).gridTemplateColumns;
    });

    // Should be 1 column or flex column
    expect(gridColumns).toContain('1fr');
  });

  test('should stack videos vertically on mobile (375x667)', async ({ page }) => {
    await page.setViewportSize({ width: 375, height: 667 });

    await page.goto('/login');
    await page.fill('input[name="email"]', TEST_USERS.STUDENT.email);
    await page.fill('input[name="password"]', TEST_USERS.STUDENT.password);
    await page.click('button[type="submit"]');

    await page.goto('/osces/TEST-CARDIO-VIDEO-001');

    // Videos should be in column layout
    const videosContainer = page.locator('[data-testid="essential-videos-container"]');
    const flexDirection = await videosContainer.evaluate(el => {
      return window.getComputedStyle(el).flexDirection;
    });

    expect(flexDirection).toBe('column');
  });

  test('should have touch targets ≥ 44x44px on mobile', async ({ page }) => {
    await page.setViewportSize({ width: 375, height: 667 });

    await page.goto('/login');
    await page.fill('input[name="email"]', TEST_USERS.STUDENT.email);
    await page.fill('input[name="password"]', TEST_USERS.STUDENT.password);
    await page.click('button[type="submit"]');

    await page.goto('/osces/TEST-CARDIO-VIDEO-001');

    const videoLink = page.locator('[data-testid="essential-video-card"]').first().locator('a[data-testid="video-link"]');
    const box = await videoLink.boundingBox();

    expect(box!.width).toBeGreaterThanOrEqual(44);
    expect(box!.height).toBeGreaterThanOrEqual(44);
  });

  test('should keep text readable on all screen sizes', async ({ page }) => {
    // Test on mobile
    await page.setViewportSize({ width: 375, height: 667 });

    await page.goto('/login');
    await page.fill('input[name="email"]', TEST_USERS.STUDENT.email);
    await page.fill('input[name="password"]', TEST_USERS.STUDENT.password);
    await page.click('button[type="submit"]');

    await page.goto('/osces/TEST-CARDIO-VIDEO-001');

    const videoTitle = page.locator('[data-testid="essential-video-card"]').first().locator('[data-testid="video-title"]');
    const fontSize = await videoTitle.evaluate(el => {
      return window.getComputedStyle(el).fontSize;
    });

    // Font size should be at least 14px for readability
    const fontSizeValue = parseInt(fontSize);
    expect(fontSizeValue).toBeGreaterThanOrEqual(14);
  });

  test('should scale images appropriately on mobile', async ({ page }) => {
    await page.setViewportSize({ width: 375, height: 667 });

    await page.goto('/login');
    await page.fill('input[name="email"]', TEST_USERS.STUDENT.email);
    await page.fill('input[name="password"]', TEST_USERS.STUDENT.password);
    await page.click('button[type="submit"]');

    await page.goto('/osces/TEST-CARDIO-VIDEO-001');

    const videoIcon = page.locator('[data-testid="essential-video-card"]').first().locator('[data-testid="video-icon"]');

    // Icon should not overflow container
    const maxWidth = await videoIcon.evaluate(el => {
      return window.getComputedStyle(el).maxWidth;
    });

    expect(maxWidth).toBe('100%');
  });

  test('should NOT have horizontal scroll on mobile', async ({ page }) => {
    await page.setViewportSize({ width: 375, height: 667 });

    await page.goto('/login');
    await page.fill('input[name="email"]', TEST_USERS.STUDENT.email);
    await page.fill('input[name="password"]', TEST_USERS.STUDENT.password);
    await page.click('button[type="submit"]');

    await page.goto('/osces/TEST-CARDIO-VIDEO-001');

    // Check body doesn't have horizontal overflow
    const hasHorizontalScroll = await page.evaluate(() => {
      return document.body.scrollWidth > document.body.clientWidth;
    });

    expect(hasHorizontalScroll).toBeFalsy();
  });

  test('should have smooth grid → stack transition', async ({ page }) => {
    // Start desktop
    await page.setViewportSize({ width: 1920, height: 1080 });

    await page.goto('/login');
    await page.fill('input[name="email"]', TEST_USERS.STUDENT.email);
    await page.fill('input[name="password"]', TEST_USERS.STUDENT.password);
    await page.click('button[type="submit"]');

    await page.goto('/osces/TEST-ABDO-VIDEO-001');

    // Resize to mobile
    await page.setViewportSize({ width: 375, height: 667 });

    // Layout should adapt without errors
    const videosContainer = page.locator('[data-testid="essential-videos-container"]');
    await expect(videosContainer).toBeVisible();
  });
});

test.describe('OSCE Video Resources - Accessibility', () => {
  test('should have descriptive aria-labels on video links', async ({ page }) => {
    await page.goto('/login');
    await page.fill('input[name="email"]', TEST_USERS.STUDENT.email);
    await page.fill('input[name="password"]', TEST_USERS.STUDENT.password);
    await page.click('button[type="submit"]');

    await page.goto('/osces/TEST-CARDIO-VIDEO-001');

    const videoLink = page.locator('[data-testid="essential-video-card"]').first().locator('a[data-testid="video-link"]');
    const ariaLabel = await videoLink.getAttribute('aria-label');

    expect(ariaLabel).toBeTruthy();
    expect(ariaLabel).toContain('Watch');
  });

  test('should have alt text on external link icon', async ({ page }) => {
    await page.goto('/login');
    await page.fill('input[name="email"]', TEST_USERS.STUDENT.email);
    await page.fill('input[name="password"]', TEST_USERS.STUDENT.password);
    await page.click('button[type="submit"]');

    await page.goto('/osces/TEST-CARDIO-VIDEO-001');

    const externalIcon = page.locator('[data-testid="external-link-icon"]').first();

    // Should have aria-label or alt text
    const hasAccessibleName = await externalIcon.evaluate(el => {
      return el.hasAttribute('aria-label') || el.hasAttribute('alt');
    });

    expect(hasAccessibleName).toBeTruthy();
  });

  test('should use proper heading levels (h2 for main, h3 for supplementary)', async ({ page }) => {
    await page.goto('/login');
    await page.fill('input[name="email"]', TEST_USERS.STUDENT.email);
    await page.fill('input[name="password"]', TEST_USERS.STUDENT.password);
    await page.click('button[type="submit"]');

    await page.goto('/osces/TEST-CARDIO-VIDEO-001');

    // Essential videos should be h2
    const h2 = page.locator('h2:has-text("Essential Video Demonstrations")');
    await expect(h2).toBeVisible();

    // Supplementary videos should be h3
    const h3 = page.locator('h3:has-text("Supplementary Videos")');
    await expect(h3).toBeVisible();
  });

  test('should have aria-label on expand/collapse button', async ({ page }) => {
    await page.goto('/login');
    await page.fill('input[name="email"]', TEST_USERS.STUDENT.email);
    await page.fill('input[name="password"]', TEST_USERS.STUDENT.password);
    await page.click('button[type="submit"]');

    await page.goto('/osces/TEST-CARDIO-VIDEO-001');

    const toggleButton = page.locator('[data-testid="supplementary-videos-toggle"]');
    const ariaLabel = await toggleButton.getAttribute('aria-label');

    expect(ariaLabel).toBeTruthy();
    expect(ariaLabel).toMatch(/Toggle supplementary videos|Show more|Show less/i);
  });

  test('should support keyboard-only navigation', async ({ page }) => {
    await page.goto('/login');
    await page.fill('input[name="email"]', TEST_USERS.STUDENT.email);
    await page.fill('input[name="password"]', TEST_USERS.STUDENT.password);
    await page.click('button[type="submit"]');

    await page.goto('/osces/TEST-CARDIO-VIDEO-001');

    // Tab to first video link
    await page.keyboard.press('Tab');
    let attempts = 0;
    const videoLink = page.locator('[data-testid="essential-video-card"]').first().locator('a[data-testid="video-link"]');

    while (!(await videoLink.evaluate(el => el === document.activeElement)) && attempts < 30) {
      await page.keyboard.press('Tab');
      attempts++;
    }

    // Should be able to reach video link via keyboard
    await expect(videoLink).toBeFocused();
  });

  test('should announce video metadata to screen readers', async ({ page }) => {
    await page.goto('/login');
    await page.fill('input[name="email"]', TEST_USERS.STUDENT.email);
    await page.fill('input[name="password"]', TEST_USERS.STUDENT.password);
    await page.click('button[type="submit"]');

    await page.goto('/osces/TEST-CARDIO-VIDEO-001');

    const videoCard = page.locator('[data-testid="essential-video-card"]').first();

    // Card should have role or proper semantic structure
    const hasProperStructure = await videoCard.evaluate(el => {
      return el.tagName === 'ARTICLE' || el.hasAttribute('role');
    });

    expect(hasProperStructure).toBeTruthy();
  });

  test('should have visible focus indicators on all interactive elements', async ({ page }) => {
    await page.goto('/login');
    await page.fill('input[name="email"]', TEST_USERS.STUDENT.email);
    await page.fill('input[name="password"]', TEST_USERS.STUDENT.password);
    await page.click('button[type="submit"]');

    await page.goto('/osces/TEST-CARDIO-VIDEO-001');

    const videoLink = page.locator('[data-testid="essential-video-card"]').first().locator('a[data-testid="video-link"]');
    await videoLink.focus();

    // Should have visible outline or focus ring
    const outlineWidth = await videoLink.evaluate(el => {
      const styles = window.getComputedStyle(el);
      return styles.outlineWidth;
    });

    expect(outlineWidth).not.toBe('0px');
  });

  test('should have color contrast ratio ≥ 4.5:1 for text', async ({ page }) => {
    // This would typically use @axe-core/playwright for automated checking
    await page.goto('/login');
    await page.fill('input[name="email"]', TEST_USERS.STUDENT.email);
    await page.fill('input[name="password"]', TEST_USERS.STUDENT.password);
    await page.click('button[type="submit"]');

    await page.goto('/osces/TEST-CARDIO-VIDEO-001');

    // Manual check: get text color and background color
    const videoTitle = page.locator('[data-testid="essential-video-card"]').first().locator('[data-testid="video-title"]');

    const colors = await videoTitle.evaluate(el => {
      const styles = window.getComputedStyle(el);
      return {
        color: styles.color,
        backgroundColor: styles.backgroundColor,
      };
    });

    // Would need color contrast calculation library for exact ratio
    // For now, just verify colors are set
    expect(colors.color).toBeTruthy();
    expect(colors.backgroundColor).toBeTruthy();
  });

  test('should work with "Skip to main content" link', async ({ page }) => {
    await page.goto('/login');
    await page.fill('input[name="email"]', TEST_USERS.STUDENT.email);
    await page.fill('input[name="password"]', TEST_USERS.STUDENT.password);
    await page.click('button[type="submit"]');

    await page.goto('/osces/TEST-CARDIO-VIDEO-001');

    // Press Tab to reveal skip link
    await page.keyboard.press('Tab');

    const skipLink = page.locator('a:has-text("Skip to main content")');

    if (await skipLink.isVisible()) {
      await skipLink.click();

      // Main content should be focused
      const main = page.locator('main');
      await expect(main).toBeFocused();
    }
  });

  test('should have proper landmark regions', async ({ page }) => {
    await page.goto('/login');
    await page.fill('input[name="email"]', TEST_USERS.STUDENT.email);
    await page.fill('input[name="password"]', TEST_USERS.STUDENT.password);
    await page.click('button[type="submit"]');

    await page.goto('/osces/TEST-CARDIO-VIDEO-001');

    // Check for main landmark
    const main = page.locator('main');
    await expect(main).toBeVisible();

    // Check for nav landmark (if present)
    const nav = page.locator('nav');
    if (await nav.count() > 0) {
      await expect(nav.first()).toBeVisible();
    }
  });
});

test.describe('OSCE Video Resources - Edge Cases', () => {
  test('should handle OSCE with no video_resources field at all', async ({ page }) => {
    await page.goto('/login');
    await page.fill('input[name="email"]', TEST_USERS.STUDENT.email);
    await page.fill('input[name="password"]', TEST_USERS.STUDENT.password);
    await page.click('button[type="submit"]');

    await page.goto('/osces/TEST-NEURO-HISTORY-001');

    // Should not display any video sections
    const essentialHeader = page.locator('h2:has-text("Essential Video Demonstrations")');
    await expect(essentialHeader).not.toBeVisible();

    const supplementaryHeader = page.locator('h3:has-text("Supplementary Videos")');
    await expect(supplementaryHeader).not.toBeVisible();

    // Page should still render correctly
    const stationTitle = page.locator('h1');
    await expect(stationTitle).toBeVisible();
  });

  test('should handle video with missing optional field (duration)', async ({ page }) => {
    // Would need test data with missing duration
    // Create a mock OSCE without duration for one video
    await page.goto('/login');
    await page.fill('input[name="email"]', TEST_USERS.STUDENT.email);
    await page.fill('input[name="password"]', TEST_USERS.STUDENT.password);
    await page.click('button[type="submit"]');

    // Mock API response with missing duration
    await page.route('**/api/v1/osces/TEST-CARDIO-VIDEO-001', async route => {
      const response = await route.fetch();
      const json = await response.json();

      // Remove duration from first video
      if (json.video_resources && json.video_resources.essential_videos[0]) {
        delete json.video_resources.essential_videos[0].duration_minutes;
      }

      route.fulfill({ json });
    });

    await page.goto('/osces/TEST-CARDIO-VIDEO-001');

    // Should still display video, just without duration
    const videoCard = page.locator('[data-testid="essential-video-card"]').first();
    await expect(videoCard).toBeVisible();

    // Duration field should not be shown or should show "Duration not available"
    const durationField = videoCard.locator('[data-testid="video-duration"]');
    const durationText = await durationField.textContent();
    expect(durationText).toMatch(/Not available|^$/i);
  });

  test('should handle video with missing Australian relevance field', async ({ page }) => {
    await page.goto('/login');
    await page.fill('input[name="email"]', TEST_USERS.STUDENT.email);
    await page.fill('input[name="password"]', TEST_USERS.STUDENT.password);
    await page.click('button[type="submit"]');

    // Mock API with missing Australian relevance
    await page.route('**/api/v1/osces/TEST-CARDIO-VIDEO-001', async route => {
      const response = await route.fetch();
      const json = await response.json();

      if (json.video_resources && json.video_resources.essential_videos[0]) {
        delete json.video_resources.essential_videos[0].australian_relevance;
      }

      route.fulfill({ json });
    });

    await page.goto('/osces/TEST-CARDIO-VIDEO-001');

    const videoCard = page.locator('[data-testid="essential-video-card"]').first();
    await expect(videoCard).toBeVisible();

    // Australian relevance should not be shown
    const relevanceField = videoCard.locator('[data-testid="video-australian-relevance"]');
    await expect(relevanceField).not.toBeVisible();
  });

  test('should handle very long video title (truncation or wrapping)', async ({ page }) => {
    await page.goto('/login');
    await page.fill('input[name="email"]', TEST_USERS.STUDENT.email);
    await page.fill('input[name="password"]', TEST_USERS.STUDENT.password);
    await page.click('button[type="submit"]');

    // Mock API with very long title
    await page.route('**/api/v1/osces/TEST-CARDIO-VIDEO-001', async route => {
      const response = await route.fetch();
      const json = await response.json();

      if (json.video_resources && json.video_resources.essential_videos[0]) {
        json.video_resources.essential_videos[0].title =
          'This is an extremely long video title that should either truncate or wrap appropriately on the screen without breaking the layout';
      }

      route.fulfill({ json });
    });

    await page.goto('/osces/TEST-CARDIO-VIDEO-001');

    const videoTitle = page.locator('[data-testid="essential-video-card"]').first().locator('[data-testid="video-title"]');

    // Title should not overflow container
    const containerBox = await page.locator('[data-testid="essential-video-card"]').first().boundingBox();
    const titleBox = await videoTitle.boundingBox();

    if (containerBox && titleBox) {
      expect(titleBox.width).toBeLessThanOrEqual(containerBox.width);
    }
  });

  test('should handle very long "why recommended" text', async ({ page }) => {
    await page.goto('/login');
    await page.fill('input[name="email"]', TEST_USERS.STUDENT.email);
    await page.fill('input[name="password"]', TEST_USERS.STUDENT.password);
    await page.click('button[type="submit"]');

    // Mock API with very long text
    await page.route('**/api/v1/osces/TEST-CARDIO-VIDEO-001', async route => {
      const response = await route.fetch();
      const json = await response.json();

      if (json.video_resources && json.video_resources.essential_videos[0]) {
        json.video_resources.essential_videos[0].why_recommended =
          'This is an extremely long explanation of why this video is recommended. It goes into extensive detail about the teaching methodology, the quality of the demonstrations, the relevance to AMC Clinical exam, and many other factors that make this an excellent learning resource.';
      }

      route.fulfill({ json });
    });

    await page.goto('/osces/TEST-CARDIO-VIDEO-001');

    const whyRecommended = page.locator('[data-testid="essential-video-card"]').first().locator('[data-testid="video-why-recommended"]');

    // Text should be truncated or have "Read more" functionality
    const text = await whyRecommended.textContent();
    const isTruncated = text!.length < 300; // Assuming truncation at ~200 chars

    // OR check for "Read more" button
    const readMoreButton = page.locator('button:has-text("Read more")');
    const hasReadMore = await readMoreButton.count() > 0;

    expect(isTruncated || hasReadMore).toBeTruthy();
  });

  test('should handle invalid video URL gracefully', async ({ page }) => {
    await page.goto('/login');
    await page.fill('input[name="email"]', TEST_USERS.STUDENT.email);
    await page.fill('input[name="password"]', TEST_USERS.STUDENT.password);
    await page.click('button[type="submit"]');

    // Mock API with invalid URL
    await page.route('**/api/v1/osces/TEST-CARDIO-VIDEO-001', async route => {
      const response = await route.fetch();
      const json = await response.json();

      if (json.video_resources && json.video_resources.essential_videos[0]) {
        json.video_resources.essential_videos[0].url = 'not-a-valid-url';
      }

      route.fulfill({ json });
    });

    await page.goto('/osces/TEST-CARDIO-VIDEO-001');

    // Should either not display the video or show error
    const videoCard = page.locator('[data-testid="essential-video-card"]').first();

    // If displayed, link should be disabled or show error
    const videoLink = videoCard.locator('a[data-testid="video-link"]');
    const isDisabled = await videoLink.evaluate(el => {
      return el.hasAttribute('disabled') || el.getAttribute('href') === '#';
    });

    // Should handle gracefully (either disabled or error message)
    expect(isDisabled || (await page.locator(':has-text("Invalid video URL")').count()) > 0).toBeTruthy();
  });

  test('should handle network error fetching videos with retry mechanism', async ({ page }) => {
    await page.goto('/login');
    await page.fill('input[name="email"]', TEST_USERS.STUDENT.email);
    await page.fill('input[name="password"]', TEST_USERS.STUDENT.password);
    await page.click('button[type="submit"]');

    let attempts = 0;

    // Mock API to fail first time, succeed second time
    await page.route('**/api/v1/osces/TEST-CARDIO-VIDEO-001', route => {
      attempts++;
      if (attempts === 1) {
        route.abort('failed');
      } else {
        route.continue();
      }
    });

    await page.goto('/osces/TEST-CARDIO-VIDEO-001');

    // Should show error message with retry button
    const retryButton = page.locator('button:has-text("Retry")');

    if (await retryButton.isVisible()) {
      await retryButton.click();

      // After retry, videos should load
      const videoCard = page.locator('[data-testid="essential-video-card"]').first();
      await expect(videoCard).toBeVisible();
    }
  });

  test('should show skeleton loader while video metadata loads', async ({ page }) => {
    await page.goto('/login');
    await page.fill('input[name="email"]', TEST_USERS.STUDENT.email);
    await page.fill('input[name="password"]', TEST_USERS.STUDENT.password);
    await page.click('button[type="submit"]');

    // Slow down API response
    await page.route('**/api/v1/osces/TEST-CARDIO-VIDEO-001', async route => {
      await new Promise(resolve => setTimeout(resolve, 2000));
      route.continue();
    });

    const loadingPromise = page.goto('/osces/TEST-CARDIO-VIDEO-001', { waitUntil: 'domcontentloaded' });

    // Check for skeleton loader while loading
    const skeleton = page.locator('[data-testid="video-resources-skeleton"]');
    // May or may not be visible depending on timing

    await loadingPromise;
  });

  test('should handle multiple OSCEs with different video counts', async ({ page }) => {
    await page.goto('/login');
    await page.fill('input[name="email"]', TEST_USERS.STUDENT.email);
    await page.fill('input[name="password"]', TEST_USERS.STUDENT.password);
    await page.click('button[type="submit"]');

    // Test OSCE with 2 videos
    await page.goto('/osces/TEST-CARDIO-VIDEO-001');
    let videoCards = page.locator('[data-testid="essential-video-card"]');
    await expect(videoCards).toHaveCount(2);

    // Test OSCE with 1 video
    await page.goto('/osces/TEST-RESP-VIDEO-001');
    videoCards = page.locator('[data-testid="essential-video-card"]');
    await expect(videoCards).toHaveCount(1);

    // Test OSCE with 4 videos
    await page.goto('/osces/TEST-ABDO-VIDEO-001');
    videoCards = page.locator('[data-testid="essential-video-card"]');
    await expect(videoCards).toHaveCount(4);

    // Test OSCE with no videos
    await page.goto('/osces/TEST-NEURO-HISTORY-001');
    const noVideosSection = page.locator('h2:has-text("Essential Video Demonstrations")');
    await expect(noVideosSection).not.toBeVisible();
  });
});

test.describe('OSCE Video Resources - Integration with Real Data', () => {
  test('should work with actual OSCE OSCE-MED-CARDIO-001 from database', async ({ page }) => {
    await page.goto('/login');
    await page.fill('input[name="email"]', TEST_USERS.STUDENT.email);
    await page.fill('input[name="password"]', TEST_USERS.STUDENT.password);
    await page.click('button[type="submit"]');

    // Navigate to real OSCE that was imported with video resources
    await page.goto('/osces/OSCE-MED-CARDIO-001');

    // This OSCE should have 4 videos (from previous import)
    const videoCards = page.locator('[data-testid="essential-video-card"]');
    const count = await videoCards.count();

    // Should have at least 1 video
    expect(count).toBeGreaterThan(0);
  });

  test('should verify Stanford Medicine 25 links are valid', async ({ page }) => {
    await page.goto('/login');
    await page.fill('input[name="email"]', TEST_USERS.STUDENT.email);
    await page.fill('input[name="password"]', TEST_USERS.STUDENT.password);
    await page.click('button[type="submit"]');

    await page.goto('/osces/TEST-CARDIO-VIDEO-001');

    const stanfordVideo = page.locator('[data-testid="video-source"]:has-text("Stanford Medicine 25")').first();
    const videoCard = stanfordVideo.locator('../..');
    const link = videoCard.locator('a[data-testid="video-link"]');

    const href = await link.getAttribute('href');
    expect(href).toContain('stanfordmedicine25.stanford.edu');
    expect(href).toMatch(/^https:\/\//);
  });

  test('should verify Geeky Medics links are valid', async ({ page }) => {
    await page.goto('/login');
    await page.fill('input[name="email"]', TEST_USERS.STUDENT.email);
    await page.fill('input[name="password"]', TEST_USERS.STUDENT.password);
    await page.click('button[type="submit"]');

    await page.goto('/osces/TEST-CARDIO-VIDEO-001');

    const geekyVideo = page.locator('[data-testid="video-source"]:has-text("Geeky Medics")').first();
    const videoCard = geekyVideo.locator('../..');
    const link = videoCard.locator('a[data-testid="video-link"]');

    const href = await link.getAttribute('href');
    expect(href).toContain('geekymedics.com');
    expect(href).toMatch(/^https:\/\//);
  });

  test('should verify Oxford Medical Education links are valid', async ({ page }) => {
    await page.goto('/login');
    await page.fill('input[name="email"]', TEST_USERS.STUDENT.email);
    await page.fill('input[name="password"]', TEST_USERS.STUDENT.password);
    await page.click('button[type="submit"]');

    await page.goto('/osces/TEST-CARDIO-VIDEO-001');

    // Expand supplementary videos
    const toggleButton = page.locator('[data-testid="supplementary-videos-toggle"]');
    await toggleButton.click();

    const oxfordVideo = page.locator('[data-testid="video-source"]:has-text("Oxford")').first();
    const videoCard = oxfordVideo.locator('../..');
    const link = videoCard.locator('a[data-testid="video-link"]');

    const href = await link.getAttribute('href');
    expect(href).toContain('oxfordmedicaleducation.com');
    expect(href).toMatch(/^https:\/\//);
  });

  test('should persist video resources after page reload', async ({ page }) => {
    await page.goto('/login');
    await page.fill('input[name="email"]', TEST_USERS.STUDENT.email);
    await page.fill('input[name="password"]', TEST_USERS.STUDENT.password);
    await page.click('button[type="submit"]');

    await page.goto('/osces/TEST-CARDIO-VIDEO-001');

    // Count videos
    const videoCardsBefore = page.locator('[data-testid="essential-video-card"]');
    const countBefore = await videoCardsBefore.count();

    // Reload page
    await page.reload();

    // Videos should still be there
    const videoCardsAfter = page.locator('[data-testid="essential-video-card"]');
    const countAfter = await videoCardsAfter.count();

    expect(countAfter).toBe(countBefore);
  });

  test('should update video resources when OSCE data changes', async ({ page }) => {
    await page.goto('/login');
    await page.fill('input[name="email"]', TEST_USERS.STUDENT.email);
    await page.fill('input[name="password"]', TEST_USERS.STUDENT.password);
    await page.click('button[type="submit"]');

    // Navigate to OSCE with videos
    await page.goto('/osces/TEST-CARDIO-VIDEO-001');

    let videoCards = page.locator('[data-testid="essential-video-card"]');
    await expect(videoCards).toHaveCount(2);

    // Navigate to different OSCE
    await page.goto('/osces/TEST-RESP-VIDEO-001');

    videoCards = page.locator('[data-testid="essential-video-card"]');
    await expect(videoCards).toHaveCount(1);
  });

  test('should allow filtering OSCEs by "has videos"', async ({ page }) => {
    await page.goto('/login');
    await page.fill('input[name="email"]', TEST_USERS.STUDENT.email);
    await page.fill('input[name="password"]', TEST_USERS.STUDENT.password);
    await page.click('button[type="submit"]');

    await page.goto('/osces');

    // If there's a "Has Videos" filter
    const hasVideosFilter = page.locator('input[type="checkbox"][name="hasVideos"]');

    if (await hasVideosFilter.isVisible()) {
      await hasVideosFilter.check();

      // Results should only show OSCEs with videos
      const osceCards = page.locator('[data-testid="osce-card"]');
      const count = await osceCards.count();

      // At least TEST-CARDIO-VIDEO-001, TEST-RESP-VIDEO-001, TEST-ABDO-VIDEO-001
      expect(count).toBeGreaterThanOrEqual(3);
    }
  });

  test('should allow sorting OSCEs by video count', async ({ page }) => {
    await page.goto('/login');
    await page.fill('input[name="email"]', TEST_USERS.STUDENT.email);
    await page.fill('input[name="password"]', TEST_USERS.STUDENT.password);
    await page.click('button[type="submit"]');

    await page.goto('/osces');

    // If there's a sort option for video count
    const sortDropdown = page.locator('select[name="sortBy"]');

    if (await sortDropdown.isVisible()) {
      await sortDropdown.selectOption('videoCount');

      // OSCEs with more videos should appear first
      // This would need verification of order
    }
  });
});
