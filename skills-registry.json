    {
      "id": "mcq-generator",
      "name": "MCQ Generator",
      "category": "content_generation",
      "description": "Generate high-quality multiple choice questions for medical education with Australian medical context",
      "parameters": {
        "topic": {
          "type": "string",
          "required": true,
          "description": "Medical topic (e.g., 'cardiology', 'respiratory', 'psychiatry')"
        },
        "difficulty": {
          "type": "string",
          "enum": ["easy", "medium", "hard"],
          "default": "medium"
        },
        "count": {
          "type": "integer",
          "min": 1,
          "max": 50,
          "default": 10
        },
        "specialty": {
          "type": "string",
          "required": true
        }
      },
      "returns": {
        "type": "array",
        "items": "MCQ objects with question, options, answer, explanation, citations"
      },
      "usage": "Generate 10 medium difficulty cardiology MCQs with Australian medical context",
      "claude_command": "/generate-mcqs --topic cardiology --difficulty medium --count 10"
    },
